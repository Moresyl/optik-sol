{
  "name": "optik-sol-monorepo",
  "version": "0.4.2",
  "description": "Optik Sol workspace — a mobile web debugging console.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Moresyl and contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Moresyl/optik-sol.git"
  },
  "homepage": "https://github.com/Moresyl/optik-sol#readme",
  "bugs": {
    "url": "https://github.com/Moresyl/optik-sol/issues"
  },
  "packageManager": "pnpm@10.30.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" build",
    "dev": "pnpm --filter optik-ui css && pnpm --parallel --filter optik-ui --filter playground dev",
    "docs:dev": "pnpm --filter optik-docs dev",
    "docs:build": "pnpm --filter optik-docs build",
    "docs:preview": "pnpm --filter optik-docs preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:dist": "node scripts/verify-dist.mjs",
    "check": "pnpm audit --registry=https://registry.npmjs.org --prod --audit-level high && pnpm build && pnpm typecheck && pnpm test && pnpm test:dist && pnpm docs:build && pnpm check:buttons && pnpm check:docs-version",
    "check:offline": "pnpm install --frozen-lockfile --offline && pnpm check",
    "check:docs-version": "node scripts/verify-doc-version.mjs",
    "check:buttons": "node scripts/check-button-types.mjs",
    "typecheck": "tsc -p packages/core/tsconfig.json && tsc -p packages/ui/tsconfig.json && tsc -p packages/optik/tsconfig.json",
    "clean": "pnpm -r exec rimraf dist .turbo tsconfig.tsbuildinfo"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.0.0",
    "happy-dom": "20.14.5",
    "rimraf": "^6.0.1",
    "solid-js": "1.9.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-solid": "2.11.14",
    "vitest": "5.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
