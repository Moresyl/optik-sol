{
  "name": "optik-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Optik 面板 UI —— Solid + Shadow DOM，专为移动端真机调试打磨。",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "author": "Moresyl and contributors",
  "keywords": ["debug", "console", "devtools", "mobile", "solid", "shadow-dom"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Moresyl/optik-sol.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/Moresyl/optik-sol#readme",
  "bugs": "https://github.com/Moresyl/optik-sol/issues",
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "css": "unocss \"src/**/*.{ts,tsx}\" -c uno.config.ts -o src/generated/uno.css",
    "build": "pnpm css && vite build && tsc -p tsconfig.build.json",
    "dev": "pnpm css --watch"
  },
  "dependencies": {
    "optik-core": "workspace:*"
  },
  "peerDependencies": {
    "solid-js": "^1.9.0"
  },
  "devDependencies": {
    "@unocss/cli": "^66.7.5",
    "@unocss/preset-wind3": "^66.7.5",
    "solid-js": "^1.9.14",
    "typescript": "^5.9.3",
    "unocss": "^66.7.5",
    "vite": "^7.3.6",
    "vite-plugin-solid": "^2.11.14"
  }
}
